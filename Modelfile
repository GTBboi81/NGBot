# 【重要】ダウンロードしたファイルの絶対パスを指定
FROM "./Llama-3-ELYZA-JP-8B-q4_k_m.gguf"

# --- テンプレート設定 (Llama 3 標準) ---
TEMPLATE """{{ if .System }}<|start_header_id|>system<|end_header_id|>

{{ .System }}<|eot_id|>{{ end }}{{ if .Prompt }}<|start_header_id|>user<|end_header_id|>

{{ .Prompt }}<|eot_id|>{{ end }}<|start_header_id|>assistant<|end_header_id|>

{{ .Response }}<|eot_id|>"""

# --- パラメータ設定 ---
# 注意: num_ctx と temperature は main.py が推論リクエストごとに options で上書きする。
# 実効値は temperature=0.0 / num_ctx=config.yaml の ollama_settings.num_ctx (既定 2048)。
# ここの値は ollama run で直接叩いたときのフォールバックとして残している。

# コンテキスト長 (長い会話に対応)
PARAMETER num_ctx 8192

# 創造性の抑制 (分析用に事実重視)
PARAMETER temperature 0.1
PARAMETER top_p 0.9
PARAMETER stop "<|start_header_id|>"
PARAMETER stop "<|end_header_id|>"
PARAMETER stop "<|eot_id|>"

# --- システムプロンプト ---
SYSTEM """
あなたは公平で客観的なコールセンター分析官です。
提供された通話ログに基づき、JSON形式のみで情報を抽出してください。
推測は行わず、会話に含まれる事実のみを出力してください。
"""